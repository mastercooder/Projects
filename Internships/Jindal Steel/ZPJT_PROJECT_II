REPORT zpjt_project_ii.

" --------------------------------------------
" Type Declaration
" --------------------------------------------
TYPES: BEGIN OF lty_product,
         ono   TYPE zdeono,
         odate TYPE zdeodate,
         pm    TYPE zdepm,
         ta    TYPE zdeta,
       END OF lty_product.

DATA: lt_product TYPE TABLE OF lty_product,
      ls_product TYPE lty_product.

TYPES: BEGIN OF lty_item,
         ono   TYPE zdeono,
         oin   TYPE zdeoin,
         odesc TYPE zdeodesc,
       END OF lty_item.

DATA: lt_item TYPE TABLE OF lty_item,
      ls_item TYPE lty_item.

TYPES: BEGIN OF lty_final,
         checkbox TYPE char1,
         ono      TYPE zdeono,
         odate    TYPE zdeodate,
         pm       TYPE zdepm,
         ta       TYPE zdeta,
         oin      TYPE zdeoin,
         odesc    TYPE zdeodesc,
       END OF lty_final.

DATA: lt_final TYPE TABLE OF lty_final,
      ls_final TYPE lty_final.

" Data Table
DATA: lt_finaldata TYPE zpjt_project_tts,
      ls_finaldata TYPE zpjt_project_st.

TYPES: BEGIN OF lty_alv_final,
         checkbox  TYPE char1,
         edit_flag TYPE char1,
         ono       TYPE zdeono,
         odate     TYPE zdeodate,
         pm        TYPE zdepm,
         ta        TYPE zdeta,
         oin       TYPE zdeoin,
         odesc     TYPE zdeodesc,
       END OF lty_alv_final.

DATA: lt_alv_final TYPE TABLE OF lty_alv_final,
      ls_alv_final TYPE lty_alv_final.

" --------------------------------------------
" User Input
" --------------------------------------------
" Variables Used
DATA: lv_ono TYPE zdeono.

" Input Code
SELECTION-SCREEN: BEGIN OF BLOCK b1 WITH FRAME TITLE TEXT-000.
  SELECTION-SCREEN: SKIP 1.
  SELECT-OPTIONS: s_ono FOR lv_ono.
  SELECTION-SCREEN: SKIP 1.
SELECTION-SCREEN: END OF BLOCK b1.

" --------------------------------------------
" SQL Queries
" --------------------------------------------
SELECT ono odate pm ta
  FROM zproduct
  INTO TABLE lt_product
  WHERE ono IN s_ono.

IF lt_product IS NOT INITIAL.
  SELECT ono oin odesc
    FROM zitem
    INTO TABLE lt_item
    FOR ALL ENTRIES IN lt_product
    WHERE ono = lt_product-ono.
ENDIF.


" --------------------------------------------
" Putting Values
" --------------------------------------------

IF lt_item IS NOT INITIAL.
  LOOP AT lt_product INTO ls_product.
    LOOP AT lt_item INTO ls_item.
      ls_finaldata-ono = ls_product-ono.
      ls_finaldata-odate = ls_product-odate.
      ls_finaldata-pm = ls_product-pm.
      ls_finaldata-ta = ls_product-ta.
      ls_finaldata-oin = ls_item-oin.
      ls_finaldata-odesc = ls_item-odesc.
      APPEND ls_finaldata TO lt_finaldata.
      CLEAR ls_finaldata.
    ENDLOOP.
  ENDLOOP.
ENDIF.

LOOP AT lt_finaldata INTO ls_finaldata.
  CLEAR ls_alv_final.
  ls_alv_final-checkbox = space.
  ls_alv_final-edit_flag = space.
  ls_alv_final-ono      = ls_finaldata-ono.
  ls_alv_final-odate    = ls_finaldata-odate.
  ls_alv_final-pm       = ls_finaldata-pm.
  ls_alv_final-ta       = ls_finaldata-ta.
  ls_alv_final-oin      = ls_finaldata-oin.
  ls_alv_final-odesc    = ls_finaldata-odesc.
  APPEND ls_alv_final TO lt_alv_final.
ENDLOOP.

" --------------------------------------------
" ALV Report
" --------------------------------------------
"Variable
DATA: lt_fieldcat TYPE slis_t_fieldcat_alv,
      ls_fieldcat TYPE slis_fieldcat_alv.

" Manual Generation Field
ls_fieldcat-col_pos = '1'.
ls_fieldcat-fieldname = 'CHECKBOX'.
ls_fieldcat-tabname = 'lt_alv_final'.
ls_fieldcat-seltext_l = 'Check Box'.
ls_fieldcat-edit = 'X'.
ls_fieldcat-checkbox = 'X'.
APPEND ls_fieldcat TO lt_fieldcat.
CLEAR ls_fieldcat.

ls_fieldcat-col_pos = '2'.
ls_fieldcat-fieldname = 'ONO'.
ls_fieldcat-tabname = 'lt_alv_final'.
ls_fieldcat-seltext_l = 'Order Number'.
APPEND ls_fieldcat TO lt_fieldcat.
CLEAR ls_fieldcat.

ls_fieldcat-col_pos = '3'.
ls_fieldcat-fieldname = 'ODATE'.
ls_fieldcat-tabname = 'lt_alv_final'.
ls_fieldcat-seltext_l = 'Order Date'.
APPEND ls_fieldcat TO lt_fieldcat.
CLEAR ls_fieldcat.

ls_fieldcat-col_pos = '4'.
ls_fieldcat-fieldname = 'PM'.
ls_fieldcat-tabname = 'lt_alv_final'.
ls_fieldcat-seltext_l = 'Payment Mode'.
APPEND ls_fieldcat TO lt_fieldcat.
CLEAR ls_fieldcat.

ls_fieldcat-col_pos = '5'.
ls_fieldcat-fieldname = 'TA'.
ls_fieldcat-tabname = 'lt_alv_final'.
ls_fieldcat-seltext_l = 'Total Amount'.
APPEND ls_fieldcat TO lt_fieldcat.
CLEAR ls_fieldcat.

ls_fieldcat-col_pos = '6'.
ls_fieldcat-fieldname = 'OIN'.
ls_fieldcat-tabname = 'lt_alv_final'.
ls_fieldcat-seltext_l = 'Order Item Number'.
APPEND ls_fieldcat TO lt_fieldcat.
CLEAR ls_fieldcat.

ls_fieldcat-col_pos = '7'.
ls_fieldcat-fieldname = 'ODESC'.
ls_fieldcat-tabname = 'lt_alv_final'.
ls_fieldcat-seltext_l = 'Order Description'.
APPEND ls_fieldcat TO lt_fieldcat.
CLEAR ls_fieldcat.


" Main Code
CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
  EXPORTING
    i_callback_program       = sy-repid
    i_callback_pf_status_set = 'PF_STATUS'
    i_callback_user_command  = 'USR_COMMAND'
  TABLES
    t_outtab                 = lt_alv_final
  EXCEPTIONS
    program_error            = 1
    OTHERS                   = 2.
IF sy-subrc <> 0.
* Implement suitable error handling here
ENDIF.
FORM pf_status USING rt_extab TYPE slis_t_extab.
  SET PF-STATUS 'OPTIONS'.
ENDFORM.
FORM usr_command USING r_ucomm     LIKE sy-ucomm
                        rs_selfield TYPE slis_selfield.

  CASE r_ucomm.

    WHEN 'SELECT'. " Select All
      LOOP AT lt_alv_final ASSIGNING FIELD-SYMBOL(<fs_alv>).
        <fs_alv>-checkbox = 'X'.
      ENDLOOP.
      rs_selfield-refresh = 'X'.

    WHEN 'DESELECT'. " Deselect All
      LOOP AT lt_alv_final ASSIGNING <fs_alv>.
        <fs_alv>-checkbox = space.
      ENDLOOP.
      rs_selfield-refresh = 'X'.

    WHEN 'SMARTFORM'. " Call Smartform
      PERFORM smartfroms.

  ENDCASE.

ENDFORM.
FORM smartfroms.
*" --------------------------------------------
*" Implimenting Smartfroms
*" --------------------------------------------
*"Variables
  DATA: lv_fname TYPE rs38l_fnam.
  DATA: lv_control_parameters TYPE ssfctrlop.
  DATA: lv_output_options TYPE ssfcompop.


  "Main Code
  CALL FUNCTION 'SSF_FUNCTION_MODULE_NAME'
    EXPORTING
      formname           = 'ZPJT_PROJECT_II_SF'
*     VARIANT            = ' '
*     DIRECT_CALL        = ' '
    IMPORTING
      fm_name            = lv_fname
    EXCEPTIONS
      no_form            = 1
      no_function_module = 2
      OTHERS             = 3.
  IF sy-subrc <> 0.
* Implement suitable error handling here
  ENDIF.


  lv_control_parameters-no_dialog = 'X'.
  lv_control_parameters-preview = 'X'.
  lv_output_options-tddest = 'LP01'.

  CALL FUNCTION lv_fname
    EXPORTING
      control_parameters = lv_control_parameters
      output_options     = lv_output_options
      user_settings      = ' '
      lt_data            = lt_finaldata.
  .
  IF sy-subrc <> 0.
  ENDIF.
ENDFORM.
